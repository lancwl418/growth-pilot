# Database (Neon / Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/growth_pilot?sslmode=require"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=  # Generate with: openssl rand -base64 32

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allowed emails (comma-separated) or domain
ALLOWED_EMAILS=user@example.com
# ALLOWED_DOMAIN=example.com

# Shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxx
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=

# GA4 (added later)
# GA4_PROPERTY_ID=properties/123456789
# GA4_CREDENTIALS_JSON=  # Base64-encoded service account JSON

# Meta Ads
# META_ADS_ACCESS_TOKEN=  # Long-lived token from Meta Business
# META_ADS_ACCOUNT_ID=    # Ad account ID (without "act_" prefix)

# Cron Security
CRON_SECRET=  # Generate with: openssl rand -base64 32

# Email Notifications (Resend)
RESEND_API_KEY=re_xxxxx
ALERT_EMAIL_RECIPIENTS=you@example.com
